# HLTV API Environment Configuration
# Use this when running the Spring Boot app outside Docker

# 2Captcha API Key for solving captchas
TWOCAPTCHA_API_KEY=APIKEY

# Browserless URL - connects to dockerized browserless on localhost
HLTV_BROWSERLESS_URL=ws://localhost:3000

# Skip Playwright browser download (using browserless instead)
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
